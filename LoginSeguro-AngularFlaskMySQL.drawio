        <mxCell id="COoIqKB-spXAwqodPLi7-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Frontend Angular" vertex="1">
          <mxGeometry height="30" width="60" x="165" y="45" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Backend Flask" vertex="1">
          <mxGeometry height="30" width="60" x="510" y="45" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-11" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;ul&gt;&lt;li&gt;Utilizar JWT para o cookie de sessão&lt;/li&gt;&lt;li&gt;Armazenar tokens em Cookies HttpOnly e Secure&lt;/li&gt;&lt;li&gt;Implementar Autenticação Multifator&lt;/li&gt;&lt;li&gt;Evitar innerHTML, manipular diretamente o DOM ou métodos que ignoram a segurança (bypassSecurityTrust...)&lt;/li&gt;&lt;li&gt;Usar canActivate para evitar que usuário acesse dados financeiros sem logar (mas validar também no backend)&lt;/li&gt;&lt;li&gt;Utilizar compilador AoT (Padrão a partir da v17)&lt;/li&gt;&lt;li&gt;Nunca armazenar chaves de API ou outros segredos na aplicação. Utilizar arquivos .ENV&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="335" width="200" x="80" y="75" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Conexão HTTPS" vertex="1">
          <mxGeometry height="30" width="100" x="-60" y="150" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-13" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;ul&gt;&lt;li&gt;&lt;b&gt;Autoridade de Confiança&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Usar rate limiting nos endpoints de login.&lt;/li&gt;&lt;li&gt;Usar ORM SQLAlchemy&lt;/li&gt;&lt;li&gt;Validar todas as entradas e tratar como &quot;dado sujo&quot;.&lt;/li&gt;&lt;li&gt;Certificar que o usuário tem permissão para acessar aquele dado financeiro específico (evitando Broken Access Control - A01 do OWASP)&lt;/li&gt;&lt;li&gt;Configurar CORS corretamente.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="200" width="230" x="425" y="102.5" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-14" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;ul&gt;&lt;li&gt;Armazenar hash de senha com salt&lt;/li&gt;&lt;li&gt;Nunca Armazenar a senha pura&lt;/li&gt;&lt;li&gt;Usuário que o Flask utiliza deve ter o menor privilégio possível (Select e Insert). Nunca root.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="210" x="770" y="100" as="geometry" />
