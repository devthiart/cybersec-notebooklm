        <mxCell id="COoIqKB-spXAwqodPLi7-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Frontend Angular" vertex="1">
          <mxGeometry height="30" width="60" x="165" y="45" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Backend Flask" vertex="1">
          <mxGeometry height="30" width="60" x="510" y="45" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-11" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;ul&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,0,0&quot;&gt;Use JWT for the session cookie&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,1,0&quot;&gt;Store tokens in HttpOnly and Secure Cookies&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,2,0&quot;&gt;Implement Multi-Factor Authentication&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,3,0&quot;&gt;Avoid innerHTML, direct DOM manipulation, or methods that bypass security (bypassSecurityTrust...)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,4,0&quot;&gt;Use CanActivate to prevent users from accessing financial data without logging in (while also validating on the backend)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,5,0&quot;&gt;Use the AoT compiler (Default starting from v17)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,6,0&quot;&gt;Never store API keys or other secrets in the application. Use .env files&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="335" width="200" x="90" y="85" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="HTTPS Connection" vertex="1">
          <mxGeometry height="30" width="110" x="-70" y="150" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-13" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;ul&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,0,0&quot;&gt;Trusted Authority&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,1,0&quot;&gt;Use rate limiting on login endpoints&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,2,0&quot;&gt;Use SQLAlchemy ORM&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,3,0&quot;&gt;Validate all inputs and treat them as &quot;dirty data&quot;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,4,0&quot;&gt;Ensure the user has permission to access that specific financial record (preventing Broken Access Control - OWASP A01)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,5,0&quot; style=&quot;line-height: 100%;&quot;&gt;Configure CORS correctly&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="250" width="225" x="427.5" y="80" as="geometry" />
        </mxCell>
        <mxCell id="COoIqKB-spXAwqodPLi7-14" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;ul&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,0,0&quot;&gt;Store password hash with salt&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,1,0&quot;&gt;Never store plain text passwords&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;0,2,0&quot;&gt;The user that Flask uses must have the least privilege possible (SELECT and INSERT). Never root.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="210" x="770" y="105" as="geometry" />
        </mxCell>
